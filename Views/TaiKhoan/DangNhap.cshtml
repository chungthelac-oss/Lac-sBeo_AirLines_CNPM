@model DatVeMayBay.Models.DangNhapViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="bg-light rounded-3 py-5 px-3">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <h2 class="fw-bold border-bottom border-primary border-2 pb-2 mb-4">Tài khoản của tôi</h2>

            <div class="bg-white p-4 shadow-sm">
                <h4 class="fw-bold mb-3">Đăng nhập</h4>

                <form asp-action="DangNhap" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="form-floating">
                        <input asp-for="Email" class="form-control" placeholder="Email" />
                        <label asp-for="Email">Email <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>

                    <div class="form-floating mt-3">
                        <input asp-for="MatKhau" class="form-control" placeholder="Mật khẩu" />
                        <label asp-for="MatKhau">Mật khẩu <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger small"></span>

                    <div class="form-check mt-3">
                        <input asp-for="GhiNho" class="form-check-input" />
                        <label asp-for="GhiNho" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">Đăng nhập</button>
                </form>

                <div class="d-flex justify-content-between mt-3">
                    <a asp-action="DangKy">Tạo tài khoản mới</a>
                    <a asp-area="" asp-controller="DatCho" asp-action="TraCuu">Tra cứu vé không cần đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}