@model List<DatVeMayBay.Models.DatCho>
@using DatVeMayBay.Models
@{
    ViewData["Title"] = "Vé của tôi";
    var thu = new[] { "CN", "T2", "T3", "T4", "T5", "T6", "T7" };

    // Gom vé theo chuyến bay: chuyến sắp bay lên trước, chuyến đã bay xuống sau
    var nhomChuyen = Model
        .GroupBy(d => d.ChuyenBayId)
        .Select(g => new
        {
            ChuyenBay = g.First().ChuyenBay!,
            Ve = g.OrderBy(d => d.TrangThai == TrangThaiDatCho.DaHuy).ThenBy(d => d.HanhKhach?.HoTen).ToList()
        })
        .OrderBy(x => x.ChuyenBay.GioCatCanh < DateTime.Now)
        .ThenBy(x => x.ChuyenBay.GioCatCanh)
        .ToList();

    var soCho = Model.Count(d => d.TrangThai == TrangThaiDatCho.ChoXacNhan);
    var soXacNhan = Model.Count(d => d.TrangThai == TrangThaiDatCho.DaXacNhan);
    var soHuy = Model.Count(d => d.TrangThai == TrangThaiDatCho.DaHuy);
}

@functions {
    string MauHang(string? ma) => ma switch
    {
        "CD" => "#0b5cad",
        "SV" => "#d6336c",
        "MT" => "#0ca678",
        _ => "#6b7787"
    };
}

<style>
    .dau-trang {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

        .dau-trang h1 {
            font-weight: 800;
            margin: 0;
        }

    /* Ô thống kê */
    .thong-ke {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 24px;
    }

    .o-tk {
        background: #fff;
        border: 1px solid var(--vien);
        border-radius: 14px;
        padding: 14px 16px;
    }

        .o-tk .so {
            font-size: 1.7rem;
            font-weight: 800;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }

        .o-tk .nhan {
            color: var(--xam);
            font-size: 0.82rem;
            margin-top: 4px;
        }

        .o-tk.vang {
            border-top: 4px solid var(--vang);
        }

        .o-tk.xanh {
            border-top: 4px solid #0ca678;
        }

        .o-tk.xam {
            border-top: 4px solid #adb5bd;
        }

        .o-tk.chinh {
            border-top: 4px solid var(--xanh);
        }

    /* Thẻ nhóm vé theo chuyến bay */
    .nhom-ve {
        background: #fff;
        border: 1px solid var(--vien);
        border-radius: 18px;
        overflow: hidden;
        margin-bottom: 18px;
        box-shadow: 0 6px 18px rgba(10, 37, 87, 0.06);
    }

        .nhom-ve.da-bay {
            opacity: 0.8;
        }

    .nhom-dau {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 16px;
        align-items: center;
        padding: 16px 22px;
        background: linear-gradient(90deg, #f1f6fd 0%, #fff 100%);
        border-bottom: 1px solid var(--vien);
    }

    .logo-hang {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        color: #fff;
        font-weight: 800;
        flex: none;
    }

    .nhom-dau .tuyen {
        font-weight: 800;
        font-size: 1.15rem;
        font-variant-numeric: tabular-nums;
    }

        .nhom-dau .tuyen .mb {
            color: var(--vang);
            margin: 0 6px;
        }

    .nhom-dau .phu {
        color: var(--xam);
        font-size: 0.85rem;
    }

    .nhan-chuyen {
        border-radius: 999px;
        padding: 5px 12px;
        font-size: 0.8rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .nhan-chuyen.sap {
            background: #e8f1fc;
            color: var(--xanh-dam);
        }

        .nhan-chuyen.cu {
            background: #eef0f3;
            color: var(--xam);
        }

    /* Từng vé trong nhóm */
    .dong-ve {
        display: grid;
        grid-template-columns: 120px minmax(0, 1fr) auto 130px auto;
        gap: 14px;
        align-items: center;
        padding: 14px 22px;
        border-bottom: 1px dashed var(--vien);
    }

        .dong-ve:last-child {
            border-bottom: none;
        }

        .dong-ve.huy {
            background: #fafbfc;
        }

            .dong-ve.huy .khach b {
                text-decoration: line-through;
                color: var(--xam);
            }

        .dong-ve .ma {
            font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
            font-weight: 800;
            letter-spacing: 2px;
            color: var(--xanh-dam);
            background: #f1f6fd;
            border-radius: 8px;
            padding: 4px 8px;
            text-align: center;
        }

        .dong-ve .khach small {
            display: block;
            color: var(--xam);
        }

        .dong-ve .gia {
            text-align: right;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

        .dong-ve .nut {
            display: flex;
            gap: 6px;
            justify-content: flex-end;
        }

    .nhom-cuoi {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        padding: 12px 22px;
        background: #fbfcfe;
        border-top: 1px solid var(--vien);
        font-size: 0.9rem;
    }

        .nhom-cuoi .tong {
            color: #e8590c;
            font-weight: 800;
        }

    /* Chưa có vé */
    .chua-co {
        background: #fff;
        border: 1px dashed #c9d1db;
        border-radius: 18px;
        padding: 56px 20px;
        text-align: center;
    }

        .chua-co .icon {
            font-size: 3rem;
            margin-bottom: 6px;
        }

    @@media (max-width: 991.98px) {
        .thong-ke {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .dong-ve {
            grid-template-columns: 1fr auto;
        }

            .dong-ve .ma {
                justify-self: start;
            }

            .dong-ve .gia {
                text-align: left;
            }
    }

    @@media (max-width: 575.98px) {
        .thong-ke {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .nhom-dau {
            grid-template-columns: auto 1fr;
        }

            .nhom-dau .nhan-chuyen {
                grid-column: 1 / -1;
                justify-self: start;
            }
    }
</style>

<div class="dau-trang">
    <div>
        <h1>Vé của tôi</h1>
        <div class="text-muted">Tất cả vé bạn đã đặt, gom theo từng chuyến bay.</div>
    </div>
    <a asp-controller="ChuyenBay" asp-action="Index" class="btn btn-primary">+ Đặt thêm vé</a>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success">@TempData["ThongBao"]</div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger">@TempData["Loi"]</div>
}

@if (Model.Count == 0)
{
    <div class="chua-co">
        <div class="icon" aria-hidden="true">🎫</div>
        <h5 class="fw-bold">Bạn chưa đặt vé nào</h5>
        <p class="text-muted mb-3">Tìm một chuyến bay và đặt vé cho bạn và người thân chỉ trong vài phút.</p>
        <a asp-controller="ChuyenBay" asp-action="Index" class="btn btn-warning fw-bold px-4">Tìm chuyến bay</a>
    </div>
}
else
{
    <!-- ===== THỐNG KÊ ===== -->
    <div class="thong-ke">
        <div class="o-tk chinh"><div class="so">@Model.Count</div><div class="nhan">Tổng số vé</div></div>
        <div class="o-tk chinh"><div class="so">@nhomChuyen.Count</div><div class="nhan">Chuyến bay</div></div>
        <div class="o-tk vang"><div class="so">@soCho</div><div class="nhan">Chờ xác nhận</div></div>
        <div class="o-tk xanh"><div class="so">@soXacNhan</div><div class="nhan">Đã xác nhận</div></div>
        <div class="o-tk xam"><div class="so">@soHuy</div><div class="nhan">Đã huỷ</div></div>
    </div>

    <!-- ===== VÉ THEO TỪNG CHUYẾN ===== -->
    @foreach (var nhom in nhomChuyen)
    {
        var cb = nhom.ChuyenBay;
        var daBay = cb.GioCatCanh < DateTime.Now;
        var veConHieuLuc = nhom.Ve.Where(v => v.TrangThai != TrangThaiDatCho.DaHuy).ToList();

        <article class="nhom-ve @(daBay ? "da-bay" : "")">
            <header class="nhom-dau">
                <div class="logo-hang" style="background: @MauHang(cb.HangHangKhong?.Ma)">@cb.HangHangKhong?.Ma</div>
                <div>
                    <div class="tuyen">
                        @cb.DiemDi @cb.GioCatCanh.ToString("HH:mm")
                        <span class="mb" aria-hidden="true">✈</span>
                        @cb.GioHaCanh.ToString("HH:mm") @cb.DiemDen
                    </div>
                    <div class="phu">
                        @cb.HangHangKhong?.Ten · @cb.SoHieu · @thu[(int)cb.GioCatCanh.DayOfWeek], @cb.GioCatCanh.ToString("dd/MM/yyyy")
                    </div>
                </div>
                <span class="nhan-chuyen @(daBay ? "cu" : "sap")">@(daBay ? "Đã bay" : "Sắp bay")</span>
            </header>

            @foreach (var dc in nhom.Ve)
            {
                var huy = dc.TrangThai == TrangThaiDatCho.DaHuy;

                <div class="dong-ve @(huy ? "huy" : "")">
                    <div class="ma">@dc.MaDatCho</div>

                    <div class="khach">
                        <b>@dc.HanhKhach?.HoTen</b>
                        <small>Sinh ngày @(dc.HanhKhach?.NgaySinh?.ToString("dd/MM/yyyy") ?? "—")</small>
                    </div>

                    <span class="badge @dc.MauTrangThai">@dc.TenTrangThai</span>

                    <div class="gia">@dc.TongTien.ToString("N0") ₫</div>

                    <div class="nut">
                        <!-- Mở thẻ lên máy bay bằng chính chức năng tra cứu -->
                        <form asp-action="TraCuu" method="post">
                            <input type="hidden" name="maDatCho" value="@dc.MaDatCho" />
                            <input type="hidden" name="email" value="@dc.Email" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">Xem vé</button>
                        </form>

                        @if (!huy && !daBay)
                        {
                            <form asp-action="HuyVeCuaToi" asp-route-id="@dc.Id" method="post"
                                  onsubmit="return confirm('Huỷ vé @dc.MaDatCho của @dc.HanhKhach?.HoTen?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Huỷ</button>
                            </form>
                        }
                    </div>
                </div>
            }

            <footer class="nhom-cuoi">
                <span>@veConHieuLuc.Count / @nhom.Ve.Count vé còn hiệu lực</span>
                <span>Tổng: <span class="tong">@veConHieuLuc.Sum(v => v.TongTien).ToString("N0") ₫</span></span>
            </footer>
        </article>
    }
}