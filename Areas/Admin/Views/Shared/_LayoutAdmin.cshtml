@using DatVeMayBay.Models
@inject DatVeMayBay.Data.AppDbContext Db
@{
    // Layout Admin nằm bên trong layout chính của web
    Layout = "_Layout";

    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var soChoDuyet = Db.DatChos.Count(d => d.TrangThai == TrangThaiDatCho.ChoXacNhan);
    string Act(string tenController) => ctrl == tenController ? "active" : "";
}

<style>
    /* ===== KHUNG ADMIN ===== */
    .khung-admin {
        display: grid;
        grid-template-columns: 236px minmax(0, 1fr);
        gap: 24px;
        align-items: start;
    }

    .noi-dung-admin {
        min-width: 0;
    }

    /* ----- Thanh menu bên trái ----- */
    .thanh-ben {
        position: sticky;
        top: 20px;
        background: linear-gradient(180deg, #0a2557 0%, #123f85 100%);
        border-radius: 18px;
        padding: 18px 12px;
        box-shadow: 0 12px 30px rgba(10, 37, 87, 0.18);
    }

        .thanh-ben .tieu-de {
            color: #fff;
            font-weight: 800;
            font-size: 1.15rem;
            padding: 2px 12px 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
            margin-bottom: 4px;
        }

            .thanh-ben .tieu-de small {
                display: block;
                color: #ffd24d;
                font-size: 0.68rem;
                font-weight: 700;
                letter-spacing: 1.2px;
                text-transform: uppercase;
            }

        .thanh-ben .nhom {
            color: #8fa6c8;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 14px 12px 6px;
        }

        .thanh-ben a {
            position: relative;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 10px;
            color: #dbe5f3;
            text-decoration: none;
            font-weight: 500;
        }

            .thanh-ben a .ic {
                width: 22px;
                text-align: center;
            }

            .thanh-ben a:hover {
                background: rgba(255, 255, 255, 0.08);
                color: #fff;
            }

            .thanh-ben a.active {
                background: rgba(255, 255, 255, 0.15);
                color: #fff;
                font-weight: 700;
            }

                .thanh-ben a.active::before {
                    content: "";
                    position: absolute;
                    left: -12px;
                    top: 9px;
                    bottom: 9px;
                    width: 4px;
                    border-radius: 0 4px 4px 0;
                    background: var(--vang);
                }

        .thanh-ben .so-dem {
            margin-left: auto;
            background: var(--vang);
            color: #0a3f80;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 800;
            padding: 1px 8px;
        }

    /* ----- Đầu trang ----- */
    .a-quay-lai {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--xam);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 6px;
    }

        .a-quay-lai:hover {
            color: var(--xanh);
        }

    .a-dau {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

        .a-dau h1 {
            font-weight: 800;
            font-size: 1.7rem;
            margin: 0;
            text-wrap: balance;
        }

        .a-dau p {
            color: var(--xam);
            margin: 4px 0 0;
        }

    .a-nut-dau {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* ----- Thông báo ----- */
    .a-bao {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 16px;
        font-weight: 500;
    }

        .a-bao > .ic {
            flex: none;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-size: 0.8rem;
            font-weight: 800;
            color: #fff;
        }

        .a-bao.thanh-cong {
            background: #e6f7f0;
            color: #0b6b48;
        }

            .a-bao.thanh-cong > .ic {
                background: #0ca678;
            }

        .a-bao.loi {
            background: #fdecec;
            color: #a61e1e;
        }

            .a-bao.loi > .ic {
                background: #c92a2a;
            }

    /* Khung lỗi của form: chỉ hiện khi có lỗi */
    .a-form-loi {
        background: #fdecec;
        color: #a61e1e;
        border-radius: 12px;
        padding: 10px 14px;
        margin-bottom: 14px;
    }

        .a-form-loi ul {
            margin: 0;
            padding-left: 18px;
        }

        .a-form-loi.validation-summary-valid {
            display: none;
        }

    /* ----- Thẻ ----- */
    .a-the {
        background: #fff;
        border: 1px solid var(--vien);
        border-radius: 16px;
        padding: 20px 22px;
    }

        .a-the h5 {
            font-weight: 800;
            font-size: 1.05rem;
            margin-bottom: 14px;
        }

        .a-the.khong-dem {
            padding: 0;
            overflow: hidden;
        }

    .a-the-tieu-de {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
    }

        .a-the-tieu-de h5 {
            margin: 0;
        }

    .a-dinh {
        position: sticky;
        top: 20px;
    }

    /* ----- Bảng ----- */
    .a-bang {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

        .a-bang thead th {
            background: #f6f8fb;
            color: #5b6878;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            padding: 12px 16px;
            border-bottom: 1px solid var(--vien);
            white-space: nowrap;
        }

        .a-bang td {
            padding: 13px 16px;
            border-bottom: 1px solid #eef1f5;
            vertical-align: middle;
        }

        .a-bang tbody tr:hover {
            background: #f8fbff;
        }

        .a-bang tbody tr:last-child td {
            border-bottom: none;
        }

        .a-bang tr.mo td {
            opacity: 0.55;
        }

    .a-phu {
        display: block;
        color: var(--xam);
        font-size: 0.8rem;
    }

    .a-ma {
        font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
        font-weight: 800;
        letter-spacing: 1.5px;
        color: var(--xanh-dam);
        background: #f1f6fd;
        border-radius: 7px;
        padding: 3px 8px;
        white-space: nowrap;
    }

    .a-chip {
        display: inline-block;
        font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
        font-size: 0.78rem;
        font-weight: 700;
        background: #eef3fa;
        color: var(--xanh-dam);
        border-radius: 6px;
        padding: 2px 7px;
        margin: 1px 2px 1px 0;
    }

    .logo-tron {
        flex: none;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        color: #fff;
        font-weight: 800;
        font-size: 0.85rem;
    }

    /* ----- Nhãn trạng thái ----- */
    .a-nhan {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 4px 11px;
        font-size: 0.78rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .a-nhan::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
        }

        .a-nhan.xanh {
            background: #e6f7f0;
            color: #0b8a5c;
        }

        .a-nhan.vang {
            background: #fff4d6;
            color: #a86a00;
        }

        .a-nhan.xam {
            background: #eef0f3;
            color: #6b7787;
        }

        .a-nhan.do {
            background: #fdecec;
            color: #c92a2a;
        }

        .a-nhan.duong {
            background: #e8f1fc;
            color: var(--xanh-dam);
        }

    /* ----- Nút ----- */
    .btn-vang {
        background: var(--vang);
        color: #0a3f80;
        font-weight: 800;
        border: none;
    }

        .btn-vang:hover {
            background: #ffb300;
            color: #0a3f80;
        }

    .nhom-nut {
        display: flex;
        gap: 6px;
        justify-content: flex-end;
        align-items: center;
    }

        .nhom-nut form {
            margin: 0;
        }

    .nut-nho {
        display: inline-grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: 9px;
        border: 1px solid var(--vien);
        background: #fff;
        color: #4a5768;
        text-decoration: none;
        font-size: 0.95rem;
    }

        .nut-nho:hover {
            border-color: var(--xanh);
            background: #f1f6fd;
        }

        .nut-nho.xoa:hover {
            border-color: #c92a2a;
            background: #fdecec;
        }

        .nut-nho:disabled {
            opacity: 0.35;
            cursor: not-allowed;
        }

    /* Công tắc bán vé */
    .a-cong-tac {
        position: relative;
        border: none;
        border-radius: 999px;
        background: #eef0f3;
        color: #6b7787;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 6px 12px 6px 32px;
        white-space: nowrap;
    }

        .a-cong-tac::before {
            content: "";
            position: absolute;
            left: 6px;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #adb5bd;
        }

        .a-cong-tac.bat {
            background: #d9f5e9;
            color: #0b8a5c;
        }

            .a-cong-tac.bat::before {
                background: #0ca678;
                box-shadow: 0 0 0 3px rgba(12, 166, 120, 0.2);
            }

    /* Bộ lọc dạng viên */
    .a-loc {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

        .a-loc a {
            border: 1px solid var(--vien);
            background: #fff;
            color: var(--chu);
            border-radius: 999px;
            padding: 7px 16px;
            font-size: 0.88rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .a-loc a:hover {
                border-color: var(--xanh);
                color: var(--xanh);
            }

            .a-loc a.active {
                background: var(--xanh);
                border-color: var(--xanh);
                color: #fff;
            }

        .a-loc .so {
            background: var(--vang);
            color: #0a3f80;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 800;
            padding: 0 7px;
        }

    /* ----- Form ----- */
    .a-form .form-label {
        font-size: 0.82rem;
        font-weight: 700;
        color: #4a5768;
        margin-bottom: 4px;
    }

    .a-form .form-control,
    .a-form .form-select {
        height: 46px;
        border-radius: 10px;
    }

    .a-form .input-group .form-control {
        border-radius: 10px 0 0 10px;
    }

    .a-form .input-group-text {
        border-radius: 0 10px 10px 0;
        font-weight: 700;
    }

    .a-form .form-control:focus,
    .a-form .form-select:focus {
        border-color: var(--xanh);
        box-shadow: 0 0 0 3px rgba(11, 92, 173, 0.15);
    }

    .a-phan {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--xanh);
        margin: 22px 0 10px;
    }

        .a-phan::after {
            content: "";
            flex: 1;
            height: 1px;
            background: var(--vien);
        }

        .a-phan:first-child {
            margin-top: 0;
        }

    .a-meo {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 8px;
        font-size: 0.86rem;
        color: #4a5768;
    }

        .a-meo li::before {
            content: "✓ ";
            color: #0ca678;
            font-weight: 800;
        }

    /* ----- Ô số liệu ----- */
    .a-so-lieu {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .a-o-so {
        background: #fff;
        border: 1px solid var(--vien);
        border-top: 4px solid var(--xanh);
        border-radius: 14px;
        padding: 14px 16px;
    }

        .a-o-so .so {
            font-size: 1.6rem;
            font-weight: 800;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }

        .a-o-so .nhan {
            color: var(--xam);
            font-size: 0.82rem;
            margin-top: 4px;
        }

        .a-o-so.vang {
            border-top-color: var(--vang);
        }

        .a-o-so.xanh-la {
            border-top-color: #0ca678;
        }

        .a-o-so.cam {
            border-top-color: #e8590c;
        }

    /* ----- Lưới thông tin ----- */
    .a-luoi {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 16px 20px;
    }

        .a-luoi .nhan {
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--xam);
            text-transform: uppercase;
            letter-spacing: 0.7px;
        }

        .a-luoi .gia-tri {
            font-weight: 700;
        }

    /* ----- Tuyến bay (dùng ở trang chi tiết) ----- */
    .a-tuyen {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 16px;
        align-items: center;
    }

        .a-tuyen .ma {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--xanh-dam);
            line-height: 1;
        }

        .a-tuyen .gio {
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

        .a-tuyen .giua {
            text-align: center;
            color: var(--xam);
            font-size: 0.82rem;
        }

        .a-tuyen .vach {
            position: relative;
            height: 2px;
            margin: 8px 14px;
            background: repeating-linear-gradient(90deg, #b8c4d2 0 6px, transparent 6px 10px);
        }

            .a-tuyen .vach span {
                position: absolute;
                left: 50%;
                top: 50%;
                transform: translate(-50%, -52%);
                background: #fff;
                padding: 0 6px;
                color: var(--xanh);
            }

    /* ----- Trống ----- */
    .a-trong {
        text-align: center;
        padding: 48px 20px;
        color: var(--xam);
    }

        .a-trong .ic {
            font-size: 2.4rem;
            margin-bottom: 6px;
        }

    /* ----- Điện thoại ----- */
    @@media (max-width: 991.98px) {
        .khung-admin {
            grid-template-columns: 1fr;
        }

        .thanh-ben {
            position: static;
            display: flex;
            gap: 6px;
            overflow-x: auto;
            padding: 10px;
            border-radius: 14px;
        }

            .thanh-ben .tieu-de, .thanh-ben .nhom {
                display: none;
            }

            .thanh-ben a {
                flex: none;
                white-space: nowrap;
            }

                .thanh-ben a.active::before {
                    display: none;
                }

        .a-dinh {
            position: static;
        }
    }
</style>

<div class="khung-admin">
    <!-- ===== MENU BÊN TRÁI ===== -->
    <aside class="thanh-ben" aria-label="Menu quản trị">
        <div class="tieu-de"><small>Khu quản trị</small>DatVe Admin</div>

        <div class="nhom">Vận hành</div>
        <a class="@Act("QuanLyChuyenBay")" asp-area="Admin" asp-controller="QuanLyChuyenBay" asp-action="Index">
            <span class="ic">✈</span> Chuyến bay
        </a>
        <a class="@Act("QuanLyDatCho")" asp-area="Admin" asp-controller="QuanLyDatCho" asp-action="Index">
            <span class="ic">📋</span> Duyệt vé
            @if (soChoDuyet > 0)
            {
                <span class="so-dem" title="Vé đang chờ xác nhận">@soChoDuyet</span>
            }
        </a>

        <div class="nhom">Danh mục</div>
        <a class="@Act("QuanLyHang")" asp-area="Admin" asp-controller="QuanLyHang" asp-action="Index">
            <span class="ic">🏢</span> Hãng hàng không
        </a>
        <a class="@Act("QuanLySanBay")" asp-area="Admin" asp-controller="QuanLySanBay" asp-action="Index">
            <span class="ic">🛫</span> Sân bay
        </a>
        <a class="@Act("QuanLyThanhPho")" asp-area="Admin" asp-controller="QuanLyThanhPho" asp-action="Index">
            <span class="ic">🏙</span> Thành phố
        </a>

        <div class="nhom">Khác</div>
        <a asp-area="" asp-controller="Home" asp-action="Index">
            <span class="ic">🏠</span> Về trang khách
        </a>
    </aside>

    <!-- ===== NỘI DUNG ===== -->
    <div class="noi-dung-admin">
        @if (TempData["ThongBao"] != null)
        {
            <div class="a-bao thanh-cong" role="status"><span class="ic">✓</span><span>@TempData["ThongBao"]</span></div>
        }
        @if (TempData["Loi"] != null)
        {
            <div class="a-bao loi" role="alert"><span class="ic">!</span><span>@TempData["Loi"]</span></div>
        }

        @RenderBody()
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}